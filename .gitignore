# Node
node_modules/
dist/
build/
coverage/

# Next.js / Turbopack build output (apps/web). Also ignored in apps/web/.gitignore,
# but listed at the repo ROOT so EAS Build's archive — which filters by the root
# .gitignore only — excludes the multi-GB turbopack dev cache in this monorepo
# (EAS-1: a 5 GB apps/web/.next was copied into the build tarball → ENOSPC).
.next/
.turbo/

# Environment / secrets
.env
.env.*.local
*.local

# Logs
logs/
*.log
npm-debug.log*

# OS / Editor
.DS_Store
.idea/
.vscode/
Thumbs.db

# Prisma (generated client lives in node_modules)
# already covered by node_modules/ above

# TypeScript incremental build info
*.tsbuildinfo

# Expo (local caches / generated artifacts — never commit)
.expo/

# Claude Code local state (agent worktrees, session artifacts — tool noise)
.claude/

# Local DB safety snapshots (MIG-2 pg_dump one-offs — never commit data dumps)
backups/

# FILE-1: local MinIO dev server (exes + object data — never commit)
tools/minio/
