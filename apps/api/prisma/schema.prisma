// Aaramva Shikshya — PUBLIC (platform) schema only.
// Per-tenant tables (users, refresh_tokens, students, ...) live inside each
// tenant's own Postgres schema (tenant_<slug>) and are created at runtime from
// apps/api/src/modules/tenant/tenant-schema.sql — they are intentionally NOT
// modelled here.

generator client {
  provider = "prisma-client-js"
  // Default output (node_modules/.prisma/client) — import as '@prisma/client'.
  // A custom src/ output causes the compiled dist/ to lose the generated JS;
  // the default location is always on the Node resolution path.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── PUBLIC SCHEMA (platform-level tables) ───────────────────────────────────

model Tenant {
  id           String    @id @default(uuid())
  name         String // "St. Xavier's School"
  slug         String    @unique // "sxs" → sxs.yourdomain.com (immutable: subdomain + schema key)
  logoUrl      String?
  primaryColor      String  @default("#2563EB")
  primaryForeground String?              // WCAG-safe text color on primary bg; null = use default #FFFFFF
  colorSource       String  @default("auto")  // "auto" = extracted from logo; "manual" = admin override
  logoPalette       Json?                // full vibrant palette hex map; null until first extraction
  description     String? // Short about/mission text — filled by school admin later
  motto           String? // School motto / tagline (shown on documents)
  establishedYear Int? // Year founded (AD)
  website         String?
  address      String?
  province     String? // Nepal province
  district     String? // Nepal district
  phone        String?
  alternatePhone String?
  email        String?
  panNumber    String? // Nepal PAN for IRD billing
  registrationNumber String? // Govt. school registration number
  affiliationBoard   String? // e.g. NEB, CBSE, Cambridge
  affiliationNumber  String? // Affiliation / approval number
  principalName         String? // Printed on official documents
  principalSignatureUrl String? // Signature image — report cards, certificates
  schoolStampUrl        String? // Official seal / stamp image
  // BILL-1 R12: bill header fields not already covered above.
  tagline              String? // Short line printed on bill/invoice headers
  paymentInstructions  String? // Free text — bank details, "pay by X", etc.
  qrImageUrl           String? // Payment QR code image (eSewa/bank) for bill printing
  // BILL-8: print-document accent color — deliberately separate from
  // primaryColor (the web-UI branding field, arbitrary/logo-extracted).
  // Restricted to a curated, print-tested-readable set — see
  // common/tenant-brand-color.ts. Null = slate default.
  brandColor           String?
  // BILL-8 B8-5/B8-6: print language for bills/receipts. Null = 'EN'.
  // 'NE'/'BOTH' are rejected at write time while NEPALI_PRINT_REVIEWED is
  // false (common/nepali-print-review-gate.ts) — see settings.service.ts.
  printLanguage        String?
  // BILL-4 R13: invoice-number reset policy. false (default) = CONTINUOUS
  // (counter never resets, matches every tenant's pre-existing behavior);
  // true = RESET (counter restarts each Nepali fiscal year, Shrawan-based).
  invoiceNumberingReset Boolean @default(false)
  // BILL-6 B6-3: two-tier credit-note approval threshold. Below this amount
  // an accountant may auto-post a credit note; at/above it, an owner must
  // approve. Same home as invoiceNumberingReset (public tenants row, not a
  // per-tenant schema table) — a single tenant-wide config value.
  creditNoteApprovalThreshold Decimal @default(5000) @db.Decimal(12, 2)
  isActive     Boolean   @default(true)
  // Onboarding wizard (OB1): set when the school owner finishes/dismisses guided
  // setup. Null = setup still in progress → owner is routed into the wizard.
  onboardingCompletedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  subscription Subscription?

  @@map("tenants")
}

model Plan {
  // The LIVE `plans` table came from the raw src/database/public-schema.sql DDL,
  // which gives id a DB-level `DEFAULT gen_random_uuid()`. plan.service.ts (and
  // the seed) INSERT without an id and rely on it — declare the real default so
  // Prisma never generates an `ALTER COLUMN id DROP DEFAULT` that would break them.
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  name         String // "Basic", "Pro", "Enterprise"
  monthlyPrice Decimal
  annualPrice  Decimal
  maxStudents  Int
  maxStaff     Int
  features     Json // { "elearning": true, "sms": false, ... }
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id          String             @id @default(uuid())
  tenantId    String             @unique
  planId      String
  status      SubscriptionStatus @default(TRIAL)
  trialEndsAt DateTime?
  startsAt    DateTime           @default(now())
  endsAt      DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model PlatformConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("platform_configs")
}

// Platform-admin tables were originally created out-of-band via
// src/database/public-schema.sql (raw SQL) and were untracked by Prisma —
// modelled here (MIG1) so the migration history reproduces them. UUID / VARCHAR /
// TIMESTAMPTZ types mirror that raw DDL exactly so the baseline diffs clean.
model PlatformAdmin {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  auditLogs     PlatformAuditLog[]
  refreshTokens PlatformRefreshToken[]

  @@map("platform_admins")
}

/// Platform-admin sessions. Mirrors the per-tenant `refresh_tokens` table, but
/// lives in the PUBLIC schema because platform admins are not tenant-bound.
/// Only the SHA-256 hash is stored — the raw UUID exists solely in the
/// httpOnly `platform_refresh_token` cookie. Rotated (single-use) on every
/// refresh; revoked on logout and on password change.
model PlatformRefreshToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String   @map("admin_id") @db.Uuid
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([adminId])
  @@map("platform_refresh_tokens")
}

model PlatformAuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId    String   @map("admin_id") @db.Uuid
  action     String   @db.VarChar(100)
  targetType String?  @map("target_type") @db.VarChar(50)
  targetId   String?  @map("target_id") @db.Uuid
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("platform_audit_logs")
}

model EmailLog {
  // Created with a DB-level `DEFAULT gen_random_uuid()` (20260711170000_add_email_log);
  // mail.service.ts INSERTs without an id and relies on it — see the Plan note above.
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String?  @map("tenant_id") @db.Uuid
  recipientEmail    String   @map("recipient_email")
  emailType         String   @map("email_type")
  subject           String
  status            String   @default("PENDING")
  providerMessageId String?  @map("provider_message_id")
  error             String?
  relatedUserId     String?  @map("related_user_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([relatedUserId])
  @@map("email_log")
}
