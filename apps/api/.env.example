# Generated from apps/api/src/config/env.validation.ts (the SEC-1 Joi schema)
# — that file is the source of truth; keep this in sync with it, not the
# other way around.

# ─── Required — the app REFUSES to boot without these ─────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aaramva_shikshya?schema=public"

# Signing secret for access tokens. Must be at least 32 characters.
# Generate strong values with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-openssl-rand-hex-32-min-32-chars"

# NOTE: refresh tokens are currently opaque UUIDs (SHA-256 hashed in the
# refresh_tokens table), NOT JWTs — so JWT_REFRESH_SECRET is not read anywhere
# in code today. It is still required + min-32 so the deployment invariant
# holds and a future switch to signed refresh tokens is already guarded.
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-min-32-chars"

# ─── App ────────────────────────────────────────────────────────────────────
NODE_ENV="development"                 # development | production | test
PORT="3001"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
APP_DOMAIN="aaramvashikshya.com"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:8081"

# ─── Redis ──────────────────────────────────────────────────────────────────
# Legitimately optional — the app runs (degraded) without Redis.
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"
REDIS_HOST=""

# ─── Error tracking (Sentry) ───────────────────────────────────────────────
# Optional — absent = Sentry disabled, boot notice logged instead.
SENTRY_DSN=""

# ─── Mail (MAIL-1 / MAIL-2) ─────────────────────────────────────────────────
# All optional: no SMTP_HOST and no MAIL_ETHEREAL=true means mail is disabled
# (MOCK status — sends are logged and skipped, nothing goes out).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
# MAIL-2 §2 name for the sender address (preferred over the MAIL-1 MAIL_FROM
# alias; MAIL_FROM stays a fallback).
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME=""
MAIL_FROM=""
# Dev-proof mode: auto-provisions a nodemailer Ethereal test inbox; every send
# logs a preview URL. Ignored when SMTP_HOST is set.
MAIL_ETHEREAL=false
# MAIL-2 §2 — explicit transport selector: MOCK | SMTP. Leave UNSET in
# development/CI (falls back to the legacy MAIL-1 resolution above). SMTP
# fail-fasts at boot if any required SMTP var is missing — no silent mock
# fallback in that mode.
MAIL_TRANSPORT=""

# ─── SMS (Sparrow SMS, Nepal) ───────────────────────────────────────────────
SPARROW_SMS_ENABLED=false
SPARROW_SMS_TOKEN="your_token_here"
SPARROW_SMS_SENDER="AaramvaS"

# ─── Credential delivery (REG-1 Phase 3) ───────────────────────────────────
# AES-256-GCM key for the temp-password secret store: 64 hex chars (32 bytes)
# or a 32-byte base64 value. Optional — unset disables credential delivery
# (registration still succeeds; the legacy MAIL event still handles email).
CREDENTIAL_SECRET_KEY=""
SMS_DRY_RUN=false
CREDENTIAL_DELIVERY_POLL=true

# ─── Expo push (PUSH-1) ─────────────────────────────────────────────────────
# Expo's push API needs no secret; this is only for EAS projects with
# enhanced push security enabled.
EXPO_ACCESS_TOKEN=""

# ─── Cloud placeholders (legacy, pre-FILE-1) ───────────────────────────────
AWS_BUCKET_NAME=""
AWS_REGION=""

# ─── File storage (FILE-1) — S3-compatible presigned uploads ──────────────
# MinIO in dev, R2/B2/AWS in prod. ALL FOUR of endpoint/access/secret/bucket
# must be set to enable storage; any missing = disabled (presign 503, legacy
# base64 upload path keeps working).
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET=""
# Path-style (bucket in the path) — required by MinIO and R2; false for AWS.
S3_FORCE_PATH_STYLE=true
# Public base URL for the one public-read kind (school-logo). Defaults to
# {S3_ENDPOINT}/{S3_BUCKET}; set explicitly behind a CDN/custom domain.
S3_PUBLIC_URL=""

# ─── Khalti KPG-2 / ePayment (PAY-2) ────────────────────────────────────────
# Gateway enabled only when the secret key is set; otherwise disabled with a
# boot notice (initiate → 503).
KHALTI_SECRET_KEY=""
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"

# ─── eSewa ePay v2 (PAY-1) ───────────────────────────────────────────────────
# Gateway enabled only when BOTH product code and secret are set; otherwise
# disabled with a boot notice (initiate → 503). URL defaults are the rc/UAT
# sandbox; going live = swapping these four.
ESEWA_PRODUCT_CODE=""
ESEWA_SECRET_KEY=""
ESEWA_FORM_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
ESEWA_STATUS_URL="https://rc.esewa.com.np/api/epay/transaction/status/"

# Public base URLs for gateway redirects: where eSewa/Khalti send the payer's
# browser back (API) and where our callbacks land the payer (web).
API_PUBLIC_URL=""
WEB_BASE_URL=""
