# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres (no Docker). Adjust user/password/db to match your install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aaramva_shikshya?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Set to true only when Redis is actually running (docker-compose up or local install).
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Secrets MUST be at least 32 characters or the app refuses to start (Joi
# validation in src/config/env.validation.ts). Generate strong values with:
#   openssl rand -hex 32
# JWT_REFRESH_SECRET is currently unused by code (refresh tokens are opaque
# UUIDs) but is validated/required so the invariant holds for a future switch.
JWT_ACCESS_SECRET="replace-with-openssl-rand-hex-32-min-32-chars"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-min-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_DOMAIN="aaramvashikshya.com"
NODE_ENV="development"
PORT="3001"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─── AWS S3 (used later) ─────────────────────────────────────────────────────
AWS_BUCKET_NAME=""
AWS_REGION=""

# ─── Nepal integrations ───────────────────────────────────────────────────────
SPARROW_SMS_ENABLED=false
SPARROW_SMS_TOKEN=your_token_here
SPARROW_SMS_SENDER=AaramvaS
ESEWA_SECRET_KEY=""
KHALTI_SECRET_KEY=""
