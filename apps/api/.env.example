# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres (no Docker). Adjust user/password/db to match your install.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aaramva_shikshya?schema=public"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Set to true only when Redis is actually running (docker-compose up or local install).
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ─── App ─────────────────────────────────────────────────────────────────────
APP_DOMAIN="aaramvashikshya.com"
NODE_ENV="development"
PORT="3001"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ─── AWS S3 (used later) ─────────────────────────────────────────────────────
AWS_BUCKET_NAME=""
AWS_REGION=""

# ─── Nepal integrations ───────────────────────────────────────────────────────
SPARROW_SMS_ENABLED=false
SPARROW_SMS_TOKEN=your_token_here
SPARROW_SMS_SENDER=AaramvaS
ESEWA_SECRET_KEY=""
KHALTI_SECRET_KEY=""
