# Aaramva Shikshya — web (Next.js admin portal) image.
#
# BUILD FROM apps/web (self-contained: own lockfile; bs-calendar arrives as a
# pre-built tarball, not a vendored copy of the TS source — see below):
#   docker build -t aaramva-web apps/web
#
# ── bs-calendar dependency ───────────────────────────────────────────────────
# apps/web depends on the REAL packages/bs-calendar package (no more forked
# source under apps/web/lib/bs-calendar/), but this build context is scoped
# to apps/web only, so Docker's COPY can never reach ../../packages/bs-calendar
# (or the repo-root scripts/ directory) directly. Instead, apps/web/package.json
# depends on a packed tarball at vendor/bs-calendar.tgz, generated by
# ../../scripts/vendor-bs-calendar.mjs (repo root). That tarball is gitignored
# (never committed) — WHOEVER BUILDS THIS IMAGE MUST RUN
# `node scripts/vendor-bs-calendar.mjs` FROM A FULL REPO CHECKOUT FIRST. The
# Docker build itself cannot regenerate it (no access to packages/bs-calendar
# from inside this context).
#
# apps/web's own `preinstall` script (apps/web/scripts/preinstall.mjs, COPY'd
# in below) is a thin shim: on a full checkout it delegates to the real
# repo-root vendoring script; inside this scoped Docker context it can't reach
# that script either, so it logs and exits 0, relying on the pre-vendored
# tarball already COPY'd in. (Earlier revision of this file pointed
# `preinstall` directly at `../../scripts/vendor-bs-calendar.mjs` — that path
# doesn't exist inside this build context at all, so `RUN npm ci` crashed
# with MODULE_NOT_FOUND before any fallback logic could run. Also
# deliberately NOT using `--ignore-scripts` here: sharp/msw/unrs-resolver in
# this dependency tree have real install/postinstall scripts that need to run.)
#
# Uses `output: 'standalone'` (next.config.ts): the runtime stage carries only
# the traced server bundle + static assets, no node_modules install.
# Runtime env: PORT (default 3000) / HOSTNAME per Next standalone docs.

# ── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:24-alpine AS deps
WORKDIR /app
COPY vendor/ vendor/
COPY scripts/ scripts/
COPY package.json package-lock.json ./
RUN npm ci

# ── Stage 2: build ───────────────────────────────────────────────────────────
FROM node:24-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules node_modules
COPY . .
# NEXT_PUBLIC_* vars are inlined into the client JS bundle at `next build` time,
# not read at container runtime — env_file: in docker-compose only reaches the
# runtime stage, and .dockerignore excludes .env* from the build context
# entirely, so this must come in as an explicit build ARG.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

# ── Stage 3: runtime ─────────────────────────────────────────────────────────
FROM node:24-alpine AS runtime
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/public ./public
COPY --from=build --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 3000
CMD ["node", "server.js"]
